{
	"ci": {
		"collect": {
			"url": ["http://127.0.0.1:4173/releases"],
			"numberOfRuns": 3,
			"settings": {
				"chromeFlags": "--no-sandbox --headless=new"
			}
		},
		"assert": {
			"aggregationMethod": "median-run",
			"assertions": {
				"categories:accessibility": [
					"warn",
					{
						"minScore": 0.9
					}
				],
				"categories:performance": [
					"warn",
					{
						"minScore": 0.8
					}
				],
				"total-byte-weight": [
					"warn",
					{
						"maxNumericValue": 350000
					}
				]
			}
		},
		"upload": {
			"target": "filesystem",
			"outputDir": "lighthouse-report/signed-in"
		}
	}
}
