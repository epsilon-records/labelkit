{
	"ci": {
		"collect": {
			"url": [
				"http://127.0.0.1:4173/",
				"http://127.0.0.1:4173/login",
				"http://127.0.0.1:4173/signup",
				"http://127.0.0.1:4173/terms",
				"http://127.0.0.1:4173/privacy"
			],
			"numberOfRuns": 3,
			"settings": {
				"chromeFlags": "--no-sandbox --headless=new"
			}
		},
		"assert": {
			"aggregationMethod": "median-run",
			"assertions": {
				"categories:accessibility": [
					"error",
					{
						"minScore": 1
					}
				],
				"categories:seo": [
					"error",
					{
						"minScore": 1
					}
				],
				"categories:performance": [
					"warn",
					{
						"minScore": 0.8
					}
				],
				"total-byte-weight": [
					"warn",
					{
						"maxNumericValue": 350000
					}
				]
			}
		},
		"upload": {
			"target": "filesystem",
			"outputDir": "lighthouse-report/public"
		}
	}
}
