{
	"name": "labelkit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm --filter labelkit-co check && pnpm --filter ./packages/cli check",
		"test": "vitest run --project unit",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:check": "drizzle-kit check",
		"db:drift": "node scripts/db-drift.mjs",
		"db:pgversion": "node scripts/check-pg-version.mjs",
		"test:rls": "node scripts/rls-behavior.mjs",
		"test:rls:rest": "node scripts/rls-postgrest.mjs",
		"test:storybook": "vitest run --project storybook --project component",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build -o storybook-static",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@storybook/addon-a11y": "^10.6.7",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/addon-vitest": "^10.6.7",
		"@storybook/sveltekit": "^10.6.7",
		"@sveltejs/adapter-netlify": "^7.0.1",
		"@sveltejs/kit": "^3.3.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.6",
		"@types/yauzl": "3.4.0",
		"@vitest/browser-playwright": "^5.1.1",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"storybook": "^10.6.7",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"yaml": "^2.9.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@lucide/svelte": "^1.75.0",
		"@noble/hashes": "^2.4.0",
		"@sentry/sveltekit": "^11.14.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.119.1",
		"aws4fetch": "^1.0.20",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"csv-parse": "^7.0.3",
		"drizzle-orm": "^0.45.4",
		"postgres": "4.0.0",
		"posthog-node": "^5.69.0",
		"saxes": "6.0.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2",
		"tldts": "7.5.4",
		"xmlbuilder2": "4.0.3",
		"yauzl": "3.4.0",
		"zod": "^4.6.7"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.28.0"
}
